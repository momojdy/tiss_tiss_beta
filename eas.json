        "APP_VARIANT": "development",
        "EXPO_PUBLIC_GOODIES_SHARED_PAYMENTS_RELEASED": "true",
        "EXPO_PUBLIC_SUPABASE_URL": "https://ycbirmgppwavorwudlrv.supabase.co"
      },
