{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "components",
    "data",
    "hooks",
    "lib",
    "navigation",
    "screens",
    "services",
    "store",
    "theme"
  ]
}
