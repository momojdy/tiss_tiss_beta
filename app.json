{
  "expo": {
    "name": "tiss_tiss_beta",
    "slug": "wantiss",
    "owner": "wantiss",
    "extra": {
      "eas": {
        "projectId": "277b862a-4581-4c6b-91b8-a7da40ced36e"
      }
    },
    "version": "1.10.0",
    "scheme": "wantiss",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Wantiss uses your location for nearby places and, after you accept a Goodies delivery, to share your live delivery location with the customer until the delivery is complete."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/assets/android-icon-foreground.png",
        "backgroundImage": "./src/assets/android-icon-background.png",
        "monochromeImage": "./src/assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Wantiss to use your camera to scan QR codes."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Wantiss uses your location while you are online and during active Goodies deliveries.",
          "locationAlwaysAndWhenInUsePermission": "Wantiss shares your live location with the customer only during an active Goodies delivery, including when the app is in the background. Sharing stops when the delivery ends.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "defaultChannel": "goodies"
        }
      ]
    ]
  }
}
